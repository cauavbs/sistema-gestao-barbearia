# Copie este arquivo para ".env" e preencha o que faltar.
# NUNCA suba o arquivo ".env" de verdade pro GitHub (ele já está no .gitignore).

# Gere um valor aleatório qualquer aqui, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-bem-aleatoria

# Estes dois valores já existiam expostos no firebaseConfig do login.html
# antigo (não são segredo, todo app Firebase tem isso público), então já
# vieram preenchidos com o que você já usava:
FIREBASE_API_KEY=AIzaSyCx9vj35UmazycfEg6eJnywpiEbPCedwAA
FIREBASE_DATABASE_URL=https://barbearia-sistema-6df17-default-rtdb.firebaseio.com

# Este SIM é sensível: é o caminho para o arquivo JSON da conta de serviço
# (Admin SDK), que dá acesso total ao seu banco. Veja o README.md para
# saber como gerar esse arquivo no Console do Firebase.
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
